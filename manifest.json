{
  "manifest_version": 3,
  "name": "Uniform Design Checker",
  "short_name": "Uniform Design",
  "version": "1.1.0",
  "description": "Снимайте одинаковые по логике блоки на разных страницах сайта и сравнивайте, где они выглядят по-разному. Отчёт в HTML и PDF.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Uniform Design",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "start-pick": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Снять блок для сравнения"
    }
  }
}
